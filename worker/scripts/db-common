#!/usr/bin/env bash
# Shared helpers for D1 inspection scripts — always queries remote meowmap DB.
# Source this from other db-* scripts:  source "$(dirname "$0")/db-common"
set -euo pipefail

PRETTY_FLAG=""

# Default help
if ! declare -f show_help >/dev/null 2>&1; then
    show_help() {
        echo "Usage: $(basename "$0") [--pretty]"
    }
fi

validate_int() {
    local name="$1" value="$2"
    if [[ ! "$value" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: $name must be a positive integer, got '$value'" >&2
        exit 1
    fi
}


sanitize_like() {
    local s="$1"
    s="${s//\'/''}"
    printf '%s' "$s"
}

parse_common_flags() {
    local remaining=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --pretty)   PRETTY_FLAG="1"; shift ;;
            --help|-h)  show_help; exit 0 ;;
            --)         shift; remaining+=("$@"); break ;;
            *)          remaining+=("$1"); shift ;;
        esac
    done
    set -- "${remaining[@]}"
}

# Resolve the real database UUID rather than trusting wrangler.toml.
#
# WHY: `database_id` in wrangler.toml is the literal placeholder `__D1_ID__`, which CI
# patches at deploy time and nobody patches locally. Passing the NAME does not save you —
# wrangler matches the name against the config first and then calls the API with the
# placeholder, so every script failed with "database __D1_ID__ could not be found". That
# went unnoticed for days because the old d1_query swallowed stderr, so a broken script
# and an empty table looked identical. Never swallow stderr here again.
D1_UUID=""
resolve_db() {
    [[ -n "$D1_UUID" ]] && return
    D1_UUID="$(npx wrangler d1 list --json \
        | python3 -c "import json,sys; print(next(d['uuid'] for d in json.load(sys.stdin) if d['name']=='meowmap'))")"
    if [[ -z "$D1_UUID" ]]; then
        echo "Error: could not resolve the 'meowmap' D1 database. Check 'npx wrangler whoami'." >&2
        exit 1
    fi
}

d1_query() {
    local sql="$1"
    resolve_db
    if [[ -n "$PRETTY_FLAG" ]]; then
        npx wrangler d1 execute "$D1_UUID" --remote --command "$sql"
    else
        npx wrangler d1 execute "$D1_UUID" --remote --json --command "$sql"
    fi
}
